# Copia este archivo como .env en la VM (chmod 600). El .env real NUNCA va al repo.

# Servidor: escucha solo en la IP de Tailscale del backend
BIND_HOST=100.95.114.35
BIND_PORT=8000
# Solo se confía en X-Forwarded-For si la petición viene del Nginx del frontend
FORWARDED_ALLOW_IPS=100.99.15.111
MOSTRAR_DOCS=false

# MySQL (sg-vargas-db), solo por TLS
DB_HOST=100.68.5.41
DB_PORT=3306
DB_NOMBRE=toaster_db
DB_USUARIO=app_tostadora
DB_CLAVE=PEGA_AQUI_LA_CLAVE_DE_MYSQL
DB_CA=/certs/mysql-ca.pem

# Sesión: secreto aleatorio de 64 caracteres (se genera con openssl en la VM)
JWT_SECRETO=SE_GENERA_EN_LA_VM
SESION_MINUTOS=120
# false SOLO mientras se prueba desde el Editor de Unity por http. En producción: true.
COOKIE_SEGURA=false

# Tosti (Ollama en la Mac, sg-vargas-ai)
OLLAMA_URL=http://100.108.204.51:11434
OLLAMA_MODELO=gemma3:4b

META_TOSTADAS=300
LOG_ARCHIVO=/var/log/tostadora/backend.log
